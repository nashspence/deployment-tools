{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployment-tools.invalid/contracts/ingress-adapter.schema.json",
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "generation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "listener": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
              },
              "upstream": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
              },
              "policy_digest": {
                "$ref": "common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "name",
              "listener",
              "upstream",
              "policy_digest"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "generation_digest",
        "routes"
      ],
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "generation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "listener": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
              },
              "upstream": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
              },
              "policy_digest": {
                "$ref": "common.schema.json#/$defs/Digest"
              }
            },
            "required": [
              "name",
              "listener",
              "upstream",
              "policy_digest"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "generation_digest",
        "routes"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "attempt": {
          "$ref": "adapter.schema.json#/$defs/EffectAttempt"
        }
      },
      "required": [
        "scope",
        "attempt"
      ],
      "additionalProperties": false
    },
    "Output": {
      "type": "object",
      "properties": {
        "serving_generation": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "serving_generation"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.ingress"
            },
            "method": {
              "const": "plan"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.ingress"
            },
            "method": {
              "const": "publish"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.ingress"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.ingress"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "deployment-tools.ingress"
        },
        "method": {
          "const": "plan"
        },
        "input": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
