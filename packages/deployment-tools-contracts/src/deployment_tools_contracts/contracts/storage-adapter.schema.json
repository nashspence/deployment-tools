        "allocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capacity_inodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purposes": {
          "type": "array",
          "items": {
            "enum": [
              "runtime",
              "state",
              "scratch",
              "logs"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "allocation",
        "capacity_bytes",
        "capacity_inodes",
        "purposes"
      ],
      "additionalProperties": false
