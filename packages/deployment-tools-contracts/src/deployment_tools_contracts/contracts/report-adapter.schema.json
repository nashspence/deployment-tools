{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployment-tools.invalid/contracts/report-adapter.schema.json",
  "$defs": {
    "append": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "event": {
          "$ref": "adapter.schema.json#/$defs/Artifact"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        }
      },
      "required": [
        "scope",
        "event",
        "destination"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "attempt": {
          "$ref": "adapter.schema.json#/$defs/EffectAttempt"
        }
      },
      "required": [
        "scope",
        "attempt"
      ],
      "additionalProperties": false
    },
    "Output": {
      "type": "object",
      "properties": {
        "receipt_handle": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "receipt_handle"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.report"
            },
            "method": {
              "const": "append"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.report"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "deployment-tools.report"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "deployment-tools.report"
        },
        "method": {
          "const": "append"
        },
        "input": {
          "$ref": "#/$defs/append"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "deployment-tools.report"
        },
        "method": {
          "const": "observe"
        },
        "input": {
          "$ref": "#/$defs/observe"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "deployment-tools.report"
        },
        "method": {
          "const": "reconcile"
        },
        "input": {
          "$ref": "#/$defs/reconcile"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    }
  ]
}
