            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.software"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
