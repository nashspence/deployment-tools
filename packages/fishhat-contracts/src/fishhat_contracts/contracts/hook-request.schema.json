{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/hook-request.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/hook/v1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "release_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executor_component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "domain",
            "host",
            "app",
            "source",
            "dns",
            "recovery",
            "publisher",
            "backend",
            "adapter",
            "interface",
            "dataset",
            "component"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "health",
        "configure",
        "verify-config",
        "dependency-check",
        "busy",
        "quiesce",
        "transition-assess",
        "transition-apply",
        "transition-verify",
        "capture",
        "restore",
        "verify-restore",
        "rebuild",
        "verify-rebuild"
      ]
    },
    "dataset_handles": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 512,
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
          },
          "mode": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "path",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "secret_paths": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 2,
        "maxLength": 512,
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
      }
    },
    "endpoint_bindings": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "output_directory": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512,
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  },
  "required": [
    "format",
    "id",
    "operation_id",
    "release_digest",
    "executor_component",
    "subject",
    "role",
    "dataset_handles",
    "secret_paths",
    "endpoint_bindings",
    "output_directory",
    "timeout_seconds"
  ],
  "additionalProperties": false
}
