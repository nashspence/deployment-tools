{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/resource-records.schema.json",
  "$defs": {
    "CapacitySnapshot": {
      "type": "object",
      "properties": {
        "format": {
          "const": "deployment-ops/resources/v1"
        },
        "kind": {
          "const": "CapacitySnapshot"
        },
        "owner": {
          "type": "object",
          "properties": {
            "tool": {
              "enum": [
                "host-ops",
                "app-ops"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "epoch": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "tool",
            "id",
            "epoch"
          ],
          "additionalProperties": false
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
        },
        "resource_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "boot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "control_writable": {
          "type": "boolean"
        },
        "quotas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bucket": {
                "enum": [
                  "runtime",
                  "state",
                  "scratch",
                  "logs"
                ]
              },
              "pool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
              },
              "filesystem_uuid": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "mount_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "project_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967294
              },
              "root": {
                "type": "string",
                "minLength": 2,
                "maxLength": 512,
                "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
              },
              "max_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "max_inodes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "used_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "used_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "headroom_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "headroom_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reserved_remaining_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reserved_remaining_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "enforced": {
                "type": "boolean"
              }
            },
            "required": [
              "bucket",
              "pool",
              "filesystem_uuid",
              "mount_id",
              "project_id",
              "root",
              "max_bytes",
              "max_inodes",
              "used_bytes",
              "used_inodes",
              "headroom_bytes",
              "headroom_inodes",
              "reserved_remaining_bytes",
              "reserved_remaining_inodes",
              "enforced"
            ],
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
              },
              "filesystem_uuid": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "mount_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "available_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "available_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reserve_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reserve_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reserved_remaining_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reserved_remaining_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "qualified": {
                "type": "boolean"
              }
            },
            "required": [
              "pool",
              "filesystem_uuid",
              "mount_id",
              "available_bytes",
              "available_inodes",
              "reserve_bytes",
              "reserve_inodes",
              "reserved_remaining_bytes",
              "reserved_remaining_inodes",
              "qualified"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "format",
        "kind",
        "owner",
        "account",
        "resource_generation",
        "observed_at",
        "boot_id",
        "coverage_complete",
        "control_writable",
        "quotas",
        "pools"
      ],
      "additionalProperties": false
    },
    "CapacityRequest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "deployment-ops/resources/v1"
        },
        "kind": {
          "const": "CapacityRequest"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
        },
        "resource_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimate": {
          "enum": [
            "verified-upper-bound",
            "bounded-preparation",
            "unknown"
          ]
        },
        "stage": {
          "enum": [
            "prepare",
            "activate",
            "capture",
            "restore",
            "build",
            "maintenance"
          ]
        },
        "growth": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bucket": {
                "enum": [
                  "runtime",
                  "state",
                  "scratch",
                  "logs"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "bucket",
              "bytes",
              "inodes"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "format",
        "kind",
        "operation_id",
        "account",
        "resource_generation",
        "estimate",
        "stage",
        "growth"
      ],
      "additionalProperties": false
    },
    "CapacityReservation": {
      "type": "object",
      "properties": {
        "format": {
          "const": "deployment-ops/resources/v1"
        },
        "kind": {
          "const": "CapacityReservation"
        },
        "owner": {
          "type": "object",
          "properties": {
            "tool": {
              "enum": [
                "host-ops",
                "app-ops"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "epoch": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "tool",
            "id",
            "epoch"
          ],
          "additionalProperties": false
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
        },
        "resource_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "snapshot_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "grants_digest": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "phase": {
          "enum": [
            "prepared",
            "active",
            "reconciling",
            "released",
            "failed"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
              },
              "bucket": {
                "enum": [
                  "runtime",
                  "state",
                  "scratch",
                  "logs"
                ]
              },
              "filesystem_uuid": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "project_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967294
              },
              "remaining_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "remaining_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "pool",
              "bucket",
              "filesystem_uuid",
              "project_id",
              "remaining_bytes",
              "remaining_inodes"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "format",
        "kind",
        "owner",
        "id",
        "operation_id",
        "account",
        "resource_generation",
        "request_digest",
        "snapshot_digest",
        "grants_digest",
        "created_at",
        "deadline",
        "phase",
        "claims"
      ],
      "additionalProperties": false
    },
    "CleanupInventory": {
      "type": "object",
      "properties": {
        "format": {
          "const": "deployment-ops/resources/v1"
        },
        "kind": {
          "const": "CleanupInventory"
        },
        "owner": {
          "type": "object",
          "properties": {
            "tool": {
              "enum": [
                "host-ops",
                "app-ops"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "epoch": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "tool",
            "id",
            "epoch"
          ],
          "additionalProperties": false
        },
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
        },
        "account_kind": {
          "enum": [
            "app",
            "user",
            "helper"
          ]
        },
        "store_binding": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "exclusive_control": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean"
        },
        "control_writable": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "handle": {
                "type": "string",
                "minLength": 71,
                "maxLength": 71,
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "kind": {
                "enum": [
                  "image",
                  "container",
                  "scratch",
                  "closed-log",
                  "build-cache",
                  "volume",
                  "unknown"
                ]
              },
              "native_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "managed": {
                "type": "boolean"
              },
              "last_used_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "running": {
                "type": "boolean"
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 71,
                  "maxLength": 71,
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "minItems": 0,
                "maxItems": 256
              },
              "protected_by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 0,
                "maxItems": 256
              },
              "deletion_bytes_estimate": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "producer_operation": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "producer_state": {
                "enum": [
                  "terminal",
                  "active",
                  "unknown"
                ]
              }
            },
            "required": [
              "handle",
              "kind",
              "native_id",
              "managed",
              "last_used_at",
              "running",
              "references",
              "protected_by",
              "deletion_bytes_estimate",
              "producer_operation",
              "producer_state"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "protected_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "minimum_age_seconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 9007199254740991
        },
        "max_objects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "format",
        "kind",
        "owner",
        "account",
        "account_kind",
        "store_binding",
        "generation",
        "observed_at",
        "coverage_complete",
        "exclusive_control",
        "busy",
        "control_writable",
        "items",
        "protected_roots",
        "minimum_age_seconds",
        "max_objects"
      ],
      "additionalProperties": false
    },
    "CleanupPlan": {
