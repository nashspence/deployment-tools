{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/adapter.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/adapter/v1"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
    },
    "roles": {
      "type": "array",
      "items": {
        "enum": [
          "runtime",
          "compute",
          "storage",
          "capture",
          "backup",
          "secret-source",
          "credential-issuer",
          "dns",
          "ingress",
          "network",
          "software",
          "service",
          "repository",
          "build",
          "report",
          "bootstrap-source"
        ]
      },
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true
    },
    "entrypoint": {
      "$ref": "common.schema.json#/$defs/RelativePath"
    },
    "configuration_schema": {
      "type": "object"
    },
    "component_schema": {
      "type": "object"
    },
    "implemented": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "native_qualified": {
      "const": false
    },
    "source_schema": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "id",
    "roles",
    "entrypoint",
    "configuration_schema",
    "component_schema",
    "implemented",
    "native_qualified",
    "source_schema"
  ],
  "additionalProperties": false,
  "$defs": {
    "ImplementationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
    },
    "Handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
    },
    "Generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "media_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "kind": {
          "enum": [
            "application",
            "allocation",
            "dataset",
            "backup-repository",
            "secret-source",
            "credential-issuer",
            "dns-service",
            "ingress",
            "network",
            "software",
            "service",
            "repository",
            "builder",
            "report-sink"
          ]
        },
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        }
      },
      "required": [
        "authority",
        "kind",
        "handle"
      ],
      "additionalProperties": false
    },
    "Selection": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "source_schema_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "source": {
          "type": "object",
          "maxProperties": 128
        }
      },
      "required": [
        "instance",
        "source_schema_digest",
        "source"
      ],
      "additionalProperties": false
    },
    "MutationNamespace": {
      "description": "One receiving-owner-verified canonical native mutation domain and facet. The receiving owner must resolve aliases and verify that distinct namespaces are actually disjoint, including native effects reached through host concerns and other owners. Different strings, adapter roles, or logical scopes do not establish separation. A resource may have separate lifecycle and resource-envelope facets when their native effects are disjoint.",
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "common.schema.json#/$defs/UUID",
          "description": "Canonical identity of the native administrative boundary, shared by all controllers that address it. This is not a fresh identity chosen by each adapter or scope owner."
        },
        "resource": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        },
        "facet": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "authority",
        "resource",
        "facet"
      ],
      "additionalProperties": false
    },
    "MutationAuthority": {
      "description": "Owner-accepted enrollment data, never a request authority token. A controller equal to the enrolled instance owns this scoped mutation boundary; another controller must already own the same scope and cover every listed native namespace. Delegates execute only through that controller's owning boundary and inherit its accepted binding, admission, holds, durable attempt and resource policies. Independent controllers may not overlap. Native interpretation must confine every request target and side effect to these verified domains; local record comparisons are not native qualification.",
      "type": "object",
      "properties": {
        "controller": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/MutationNamespace"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "controller",
        "namespaces"
      ],
      "additionalProperties": false
    },
    "Grant": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "access": {
          "type": "array",
          "items": {
            "enum": [
              "observe",
              "change"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "mutation": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/MutationAuthority"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "access",
        "mutation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "access": {
                "contains": {
                  "const": "change"
                }
              }
            }
          },
          "then": {
            "properties": {
              "mutation": {
                "$ref": "adapter.schema.json#/$defs/MutationAuthority"
              }
            }
          },
          "else": {
            "properties": {
              "mutation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Installation": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
        },
        "artifact": {
          "$ref": "adapter.schema.json#/$defs/Artifact"
        },
        "descriptor_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "implementation",
        "artifact",
        "descriptor_digest",
        "enabled"
      ],
      "additionalProperties": false
    },
    "Instance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "implementation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
        },
        "installation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "role": {
          "enum": [
            "runtime",
            "compute",
            "storage",
            "capture",
            "backup",
            "secret-source",
            "credential-issuer",
            "dns",
            "ingress",
            "network",
            "software",
            "service",
            "repository",
            "build",
            "report",
            "bootstrap-source"
          ]
        },
        "schema_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "configuration": {
          "type": "object",
          "maxProperties": 128
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Grant"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "implementation",
        "installation_digest",
        "role",
        "schema_digest",
        "configuration",
        "grants",
        "generation"
      ],
      "additionalProperties": false
    },
    "RuntimeBinding": {
      "description": "An owner-accepted runtime identity. Its stable binding digest is digest(canonical JSON of this record with only admission_generation omitted); every other field participates. Host app assignment, App runtime selection and this instance must agree at new admission. Source drift requires an explicit owner rebind and never retargets accepted work. Admission generation is a mutable cessation fence and is not deployment identity. Active bindings require instance_digest. A binding without that pin is retained under inhibition solely to preserve accepted work and uncertainty: it remains readable, cancellable before dispatch and settleable after dispatch, but cannot admit new work, open admission or authorize dispatch. The owner must never infer or backfill its missing authority from current enrollment.",
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "instance": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "installation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "configuration_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "native_incarnation": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "admission_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "instance_generation": {
          "$ref": "adapter.schema.json#/$defs/Generation"
        },
        "instance_digest": {
          "$ref": "common.schema.json#/$defs/Digest",
          "description": "Digest of the exact accepted runtime Instance, including configuration, generation and mutation grants. Required at bind, preparation, admission opening and dispatch; the current scope must also retain change access and name this instance as its own mutation controller. The field is structurally optional only so inhibited bindings retain custody of accepted work without inventing authority."
        }
      },
      "required": [
        "subject",
        "instance",
        "generation",
        "installation_digest",
        "configuration_digest",
        "scope",
        "native_incarnation",
        "admission_generation",
        "instance_generation"
      ],
      "additionalProperties": false
    },
    "Deployment": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        },
        "release_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "binding_digest": {
          "$ref": "common.schema.json#/$defs/Digest",
          "description": "The stable RuntimeBinding digest, computed over its canonical JSON with only admission_generation omitted. The receiving runtime owner must match it to the accepted binding before preparing a new effect."
        },
        "projection_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "handle",
        "release_digest",
        "binding_digest",
        "projection_digest",
        "components"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed_at": {
          "$ref": "common.schema.json#/$defs/Time"
        },
        "native_incarnation": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "coverage": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "activity": {
          "enum": [
            "active",
            "inactive",
            "unknown"
          ]
        },
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "unknown"
          ],
          "description": "The observed result of a supported health check; unknown does not imply failure."
        },
        "quiescence": {
          "enum": [
            "verified",
            "not-quiescent",
            "unknown"
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "instance": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "installation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "admission_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "health_check": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ],
          "description": "Whether this adapter can perform the relevant health check. Unsupported or unknown capability cannot establish healthy or unhealthy."
        }
      },
      "required": [
        "scope",
        "generation",
        "observed_at",
        "native_incarnation",
        "coverage",
        "activity",
        "health",
        "quiescence",
        "continuation",
        "instance",
        "installation_digest",
        "admission_generation",
        "health_check"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "health_check": {
                "enum": [
                  "unsupported",
                  "unknown"
                ]
              }
            },
            "required": [
              "health_check"
            ]
          },
          "then": {
            "properties": {
              "health": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "RuntimeControl": {
      "description": "Durable owner-authored control for a delegated service lifecycle attempt. This record is retained with the original attempt, not accepted as dispatch authority from a request. Starts and oneshots require open admission; stops require closed admission. The service handle must equal an enrolled lifecycle namespace resource under the accepted runtime controller.",
      "type": "object",
      "properties": {
        "binding_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "executor_instance_digest": {
          "$ref": "common.schema.json#/$defs/Digest",
          "description": "Digest of the exact accepted service Instance including configuration, generation and scoped mutation grants. Dispatch must match the currently enrolled executor; executor loss or replacement does not erase the retained attempt."
        },
        "activity": {
          "enum": [
            "running",
            "stopped",
            "oneshot-complete"
          ]
        },
        "service": {
          "$ref": "adapter.schema.json#/$defs/Handle"
        }
      },
      "required": [
        "binding_digest",
        "executor_instance_digest",
        "activity",
        "service"
      ],
      "additionalProperties": false
    },
    "EffectAttempt": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "common.schema.json#/$defs/Owner"
        },
        "operation_id": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "effect_id": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "instance": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "installation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "binding_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "native_incarnation": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "contract": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
        },
        "method": {
          "$ref": "common.schema.json#/$defs/Entry"
        },
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "runtime_control": {
          "$ref": "adapter.schema.json#/$defs/RuntimeControl",
          "description": "Present only for a service lifecycle effect delegated to a runtime owner. Its absence never grants a service executor runtime dispatch authority; direct runtime and other independently owned effects retain their original attempt representation."
        },
        "input_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "state": {
          "enum": [
            "prepared",
            "dispatched",
            "reconciling",
            "resolved"
          ]
        },
        "certainty": {
          "enum": [
            "none",
            "known",
            "unknown"
          ]
        },
        "outcome": {
          "enum": [
            "pending",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "native_task": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "owner",
        "operation_id",
        "effect_id",
        "attempt_id",
        "instance",
        "installation_digest",
        "binding_generation",
        "native_incarnation",
        "contract",
        "method",
        "scope",
        "input_digest",
        "state",
        "certainty",
        "outcome",
        "native_task"
      ],
      "additionalProperties": false,
      "dependentSchemas": {
        "runtime_control": {
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "set-activity"
            }
          }
        }
      },
      "description": "Owner-retained identity and state of one authorized native mutation. Observational reconciliation refers to this original attempt; it does not create another effect. Exact retained request bytes and any referenced immutable input closure remain in owner custody. The input digest cannot replace those bytes or authorize reconstructing them from current mutable state."
    },
    "EffectResult": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/UUID"
        },
        "input_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "acknowledgment": {
          "enum": [
            "accepted",
            "rejected",
            "unknown"
          ]
        },
        "task_state": {
          "enum": [
            "running",
            "terminal",
            "unknown"
          ]
        },
        "effect_certainty": {
          "enum": [
            "none",
            "known",
            "unknown"
          ]
        },
        "postcondition": {
          "enum": [
            "satisfied",
            "not-satisfied",
            "unknown"
          ]
        },
        "native_task": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempt_id",
        "input_digest",
        "acknowledgment",
        "task_state",
        "effect_certainty",
        "postcondition",
        "native_task"
      ],
      "additionalProperties": false
    },
    "Qualification": {
      "type": "object",
      "properties": {
        "installation_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "contract_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "configuration_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "environment_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "runner": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/Entry"
              },
              "outcome": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped",
                  "not-executed"
                ]
              }
            },
            "required": [
              "id",
              "outcome"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        },
        "external_accounts": {
          "const": false
        },
        "native_dependencies": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "installation_digest",
        "contract_digest",
        "configuration_digest",
        "environment_digest",
        "runner",
        "cases",
        "external_accounts",
        "native_dependencies"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        },
        "dataset": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "format": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*(?:[./][a-z][a-z0-9-]*)+$"
        },
        "consistency": {
          "enum": [
            "quiesced",
            "native-transaction"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "adapter.schema.json#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "restore_requirements": {
          "type": "array",
          "items": {
            "type": "string",
