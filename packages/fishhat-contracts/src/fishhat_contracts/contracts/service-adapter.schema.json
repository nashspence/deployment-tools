{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/service-adapter.schema.json",
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        },
        "activity": {
          "enum": [
            "running",
            "stopped",
            "oneshot-complete"
          ]
        }
      },
      "required": [
        "scope",
        "service",
        "activity"
      ],
      "additionalProperties": false
    },
    "set-activity": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
        },
        "activity": {
          "enum": [
            "running",
            "stopped",
            "oneshot-complete"
          ]
        }
      },
      "required": [
        "scope",
        "service",
        "activity"
      ],
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "adapter.schema.json#/$defs/Handle"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "cursor",
        "limit"
      ],
      "additionalProperties": false
    },
    "reconcile": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "adapter.schema.json#/$defs/Scope"
        },
        "attempt": {
          "$ref": "adapter.schema.json#/$defs/EffectAttempt"
        }
      },
      "required": [
        "scope",
        "attempt"
      ],
      "additionalProperties": false,
      "description": "Observe and settle the exact original retained mutation attempt without dispatching or repeating a native mutation. Any corrective mutation requires a separately reviewed and authorized effect. The attempt contract and scope must match this request, and its method must name a mutating operation of this role."
    },
    "Output": {
      "type": "object",
      "properties": {
        "activity": {
          "enum": [
            "running",
            "stopped",
            "oneshot-complete",
            "unknown"
          ]
        }
      },
      "required": [
        "activity"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "plan"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "set-activity"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "observe"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contract": {
              "const": "fishhat.service"
            },
            "method": {
              "const": "reconcile"
            },
            "request_digest": {
              "$ref": "common.schema.json#/$defs/Digest"
            },
            "scope": {
              "$ref": "adapter.schema.json#/$defs/Scope"
            },
            "coverage": {
              "enum": [
                "complete",
                "incomplete",
                "unknown"
              ]
            },
            "continuation": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Handle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "proposal": {
              "anyOf": [
                {
                  "$ref": "adapter.schema.json#/$defs/Artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "effect": {
              "$ref": "adapter.schema.json#/$defs/EffectResult"
            }
          },
          "required": [
            "contract",
            "method",
            "request_digest",
            "scope",
            "coverage",
            "continuation",
            "proposal",
            "output",
            "effect"
          ],
          "additionalProperties": false,
          "description": "request_digest identifies this reconciliation RPC; effect identifies and reports the original mutation attempt from input.attempt. These are different identities. A reconciliation result supplies no authorization to repeat or correct the mutation."
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "plan"
        },
        "input": {
          "$ref": "#/$defs/plan"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "set-activity"
        },
        "input": {
          "$ref": "#/$defs/set-activity"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "observe"
        },
        "input": {
          "$ref": "#/$defs/observe"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "const": "fishhat.service"
        },
        "method": {
          "const": "reconcile"
        },
        "input": {
          "$ref": "#/$defs/reconcile"
        }
      },
      "required": [
        "contract",
        "method",
        "input"
      ],
      "additionalProperties": false
    }
  ],
  "description": "Service identity resolves to an owner-verified native target and mutation facet. Service lifecycle and runtime lifecycle cannot have independent controllers for the same target. A service executor enrolled under a runtime controller must act only through that controller's durable attempt, accepted binding, admission and recovery protections. Direct set-activity, reconcile or generic adapter dispatch cannot supply competing authority. Native target alias resolution and exclusion remain receiving-owner obligations."
}
