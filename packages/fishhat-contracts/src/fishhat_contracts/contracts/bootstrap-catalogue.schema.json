{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/bootstrap-catalogue.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/bootstrap-catalogue/v1"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/Time"
    },
    "kit_manifest_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "$ref": "common.schema.json#/$defs/Entry"
          },
          "ref": {
            "$ref": "common.schema.json#/$defs/GitRef"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/Commit"
          },
          "adapter": {
            "$ref": "bootstrap-recovery.schema.json#/$defs/AdapterBinding"
          },
          "capture": {
            "$ref": "adapter.schema.json#/$defs/Artifact"
          },
          "tree_digest": {
            "$ref": "common.schema.json#/$defs/Digest"
          },
          "file_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "total_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "source_id",
          "ref",
          "commit",
          "adapter",
          "capture",
          "tree_digest",
          "file_count",
          "total_bytes"
        ],
        "additionalProperties": false
      }
    },
    "publication_state": {
      "enum": [
        "candidate",
        "independently-verified"
      ]
    }
  },
  "required": [
    "format",
    "domain_id",
    "created_at",
    "kit_manifest_digest",
    "sources",
    "publication_state"
  ],
  "additionalProperties": false
}
