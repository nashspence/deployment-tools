{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/resources.schema.json",
  "$defs": {
    "HostResources": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "control": {
          "type": "object",
          "properties": {
            "filesystem_uuid": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "root": {
              "type": "string",
              "minLength": 2,
              "maxLength": 512,
              "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
            },
            "reserve_bytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 9007199254740991
            },
            "reserve_inodes": {
              "type": "integer",
              "minimum": 128,
              "maximum": 9007199254740991
            },
            "emergency_file_bytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 9007199254740991
            },
            "host_memory_reserve_bytes": {
              "type": "integer",
              "minimum": 16777216,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "filesystem_uuid",
            "root",
            "reserve_bytes",
            "reserve_inodes",
            "emergency_file_bytes",
            "host_memory_reserve_bytes"
          ],
          "additionalProperties": false
        },
        "pools": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mount": {
                "type": "string",
                "minLength": 2,
                "maxLength": 512,
                "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
              },
              "filesystem_uuid": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "adapter": {
                "const": "xfs-project-v1"
              },
              "allocation_budget_bytes": {
                "type": "integer",
                "minimum": 1048576,
                "maximum": 9007199254740991
              },
              "allocation_budget_inodes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 9007199254740991
              },
              "host_reserve_bytes": {
                "type": "integer",
                "minimum": 1048576,
                "maximum": 9007199254740991
              },
              "host_reserve_inodes": {
                "type": "integer",
                "minimum": 128,
                "maximum": 9007199254740991
              },
              "other_writers_max_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "other_writers_max_inodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "overcommit": {
                "const": false
              }
            },
            "required": [
              "mount",
              "filesystem_uuid",
              "adapter",
              "allocation_budget_bytes",
              "allocation_budget_inodes",
              "host_reserve_bytes",
              "host_reserve_inodes",
              "other_writers_max_bytes",
              "other_writers_max_inodes",
              "overcommit"
            ],
            "additionalProperties": false
          },
          "minProperties": 1,
          "maxProperties": 256
        },
        "accounts": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "subject_kind": {
                "enum": [
                  "app",
                  "user",
                  "helper"
                ]
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
              },
              "login": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "compute": {
                "type": "object",
                "properties": {
                  "cpu_millis": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 1024000
                  },
                  "cpu_weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "memory_high_bytes": {
                    "type": "integer",
                    "minimum": 16777216,
                    "maximum": 9007199254740991
                  },
                  "memory_max_bytes": {
                    "type": "integer",
                    "minimum": 16777216,
                    "maximum": 9007199254740991
                  },
                  "swap_max_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tasks_max": {
                    "type": "integer",
                    "minimum": 32,
                    "maximum": 1048576
                  },
                  "io_weight": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "io_limits": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "device_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24,
                          "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
                        },
                        "read_bps": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "write_bps": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "device_id",
                        "read_bps",
                        "write_bps"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0,
                    "maxItems": 16
                  },
                  "tmpfs_max_bytes": {
                    "type": "integer",
                    "minimum": 1048576,
                    "maximum": 9007199254740991
                  },
                  "tmpfs_max_inodes": {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "cpu_millis",
                  "cpu_weight",
                  "memory_high_bytes",
                  "memory_max_bytes",
                  "swap_max_bytes",
                  "tasks_max",
                  "io_weight",
                  "io_limits",
                  "tmpfs_max_bytes",
                  "tmpfs_max_inodes"
                ],
                "additionalProperties": false
              },
              "storage": {
                "type": "object",
                "properties": {
                  "runtime": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes"
                    ],
                    "additionalProperties": false
                  },
                  "state": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes"
                    ],
                    "additionalProperties": false
                  },
                  "scratch": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes"
                    ],
                    "additionalProperties": false
                  },
                  "logs": {
                    "type": "object",
                    "properties": {
                      "pool": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 24,
                        "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
                      },
                      "root": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 512,
                        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f\\\\])[^\\n]+$"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "minimum": 1048576,
                        "maximum": 9007199254740991
                      },
                      "max_inodes": {
                        "type": "integer",
                        "minimum": 128,
                        "maximum": 9007199254740991
                      },
                      "headroom_bytes": {
                        "type": "integer",
                        "minimum": 65536,
                        "maximum": 9007199254740991
                      },
                      "headroom_inodes": {
                        "type": "integer",
                        "minimum": 16,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "pool",
                      "root",
                      "max_bytes",
                      "max_inodes",
                      "headroom_bytes",
                      "headroom_inodes"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "runtime",
                  "state",
                  "scratch",
                  "logs"
                ],
                "additionalProperties": false
              },
              "automatic_gc": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "subject_kind",
              "subject",
              "login",
              "compute",
              "storage",
              "automatic_gc",
              "reason"
            ],
            "additionalProperties": false
          },
          "minProperties": 1,
          "maxProperties": 256
        },
        "policy": {
          "type": "object",
          "properties": {
            "max_snapshot_age_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "scan_interval_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            },
            "warning_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "critical_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "clear_percent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "max_growth_operations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_gc_objects": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "max_gc_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "gc_cpu_millis": {
              "type": "integer",
              "minimum": 10,
              "maximum": 1000
            },
            "gc_memory_max_bytes": {
              "type": "integer",
              "minimum": 16777216,
              "maximum": 9007199254740991
            },
            "gc_interval_seconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 604800
            },
            "gc_jitter_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          },
          "required": [
            "max_snapshot_age_seconds",
            "scan_interval_seconds",
            "warning_percent",
            "critical_percent",
            "clear_percent",
            "max_growth_operations",
            "max_gc_objects",
            "max_gc_seconds",
            "gc_cpu_millis",
            "gc_memory_max_bytes",
            "gc_interval_seconds",
            "gc_jitter_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile",
        "control",
        "pools",
        "accounts",
        "policy"
      ],
      "additionalProperties": false
    },
    "AppRequirements": {
      "type": "object",
      "properties": {
        "minimum_memory_bytes": {
          "type": "integer",
          "minimum": 16777216,
          "maximum": 9007199254740991
        },
        "minimum_cpu_millis": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1024000
        },
        "minimum_tasks": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1048576
        },
        "storage_minimum": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            },
            "state": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            },
            "scratch": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            },
            "logs": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "inodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "bytes",
                "inodes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "runtime",
            "state",
            "scratch",
            "logs"
          ],
          "additionalProperties": false
        },
        "logs": {
          "type": "object",
          "properties": {
            "max_file_bytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 9007199254740991
            },
            "closed_retention_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000
            },
            "overflow": {
              "const": "bounded-loss-visible"
            }
          },
          "required": [
            "max_file_bytes",
            "closed_retention_seconds",
            "overflow"
          ],
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "properties": {
            "prior_releases": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "minimum_prior_age_seconds": {
              "type": "integer",
              "minimum": 86400,
              "maximum": 31536000
            },
            "unused_candidate_grace_seconds": {
              "type": "integer",
              "minimum": 3600,
              "maximum": 2592000
            },
            "cold_archive": {
              "enum": [
                "keep-local",
                "verified-independent-archive"
              ]
            }
          },
          "required": [
            "prior_releases",
            "minimum_prior_age_seconds",
            "unused_candidate_grace_seconds",
            "cold_archive"
          ],
          "additionalProperties": false
        },
        "automatic_gc": {
          "type": "boolean"
        }
      },
      "required": [
        "minimum_memory_bytes",
        "minimum_cpu_millis",
        "minimum_tasks",
        "storage_minimum",
        "logs",
        "retention",
        "automatic_gc"
      ],
      "additionalProperties": false
    }
  }
}
