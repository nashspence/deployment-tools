{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishhat.invalid/contracts/bootstrap-recovery.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/bootstrap-selection/v1"
    },
    "purpose": {
      "const": "source-only"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/UUID"
    },
    "source_identity": {
      "type": "object",
      "properties": {
        "instance": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "instance",
        "repository_id",
        "name"
      ],
      "additionalProperties": false
    },
    "helper_commit": {
      "const": "1111111111111111111111111111111111111111"
    },
    "helper_blob": {
      "const": "2222222222222222222222222222222222222222"
    },
    "kit_manifest_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "restic_repository_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bare_repository_path": {
      "$ref": "common.schema.json#/$defs/AbsolutePath"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_commit": {
      "$ref": "common.schema.json#/$defs/Commit"
    },
    "recovery_root": {
      "$ref": "common.schema.json#/$defs/AbsolutePath"
    },
    "private_profile_handle": {
      "$ref": "common.schema.json#/$defs/Entry"
    },
    "verify_only": {
      "const": true
    },
    "force_checkout": {
      "const": false
    },
    "install_dependencies": {
      "const": false
    },
    "download_tools": {
      "const": false
    },
    "full_service_restore_separate": {
      "const": true
    }
  },
  "required": [
    "format",
    "purpose",
    "domain_id",
    "source_identity",
    "helper_commit",
    "helper_blob",
    "kit_manifest_digest",
    "restic_repository_id",
    "snapshot_id",
    "bare_repository_path",
    "branch",
    "expected_commit",
    "recovery_root",
    "private_profile_handle",
    "verify_only",
    "force_checkout",
    "install_dependencies",
    "download_tools",
    "full_service_restore_separate"
  ],
  "additionalProperties": false
}
