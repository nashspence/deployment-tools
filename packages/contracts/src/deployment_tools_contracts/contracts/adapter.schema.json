{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployment-tools.invalid/contracts/adapter.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/adapter/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input_schema_digest": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "output_schema_digest": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "reconcile_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
          },
          "credentials": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
            },
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true
          },
          "effects": {
            "type": "array",
            "items": {
              "enum": [
                "files",
                "packages",
                "services",
                "provider",
                "native-state",
                "runtime"
              ]
            },
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true
          }
        },
        "required": [
          "input_schema_digest",
          "output_schema_digest",
          "reconcile_action",
          "credentials",
          "effects"
        ],
        "additionalProperties": false
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux",
          "macos",
          "appliance"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "artifact_digest",
    "publisher",
    "entrypoint",
    "actions",
    "platforms"
  ],
  "additionalProperties": false
}
