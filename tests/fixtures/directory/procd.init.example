#!/bin/sh /etc/rc.common
# Blueprint only. Validate the vendor's procd helpers and runtime schema first.
# Nothing here creates firewall rules, downloads code, or touches DNS/DHCP/VPN.
# Qualified package must provision opsdir and read-only files before enabling.
USE_PROCD=1
START=95
STOP=10
start_service() {
    /usr/libexec/domain-ops-directory check \
        --config /etc/domain-ops-directory/directory.yaml \
        --runtime /etc/domain-ops-directory/runtime.yaml || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/domain-ops-directory serve \
        --config /etc/domain-ops-directory/directory.yaml \
        --runtime /etc/domain-ops-directory/runtime.yaml
    procd_set_param user opsdir
    procd_set_param group opsdir
    procd_set_param env GOMAXPROCS=1 GOMEMLIMIT=32MiB
    procd_set_param nice 10
    procd_set_param limits core="0 0" nofile="64 64"
    # Threshold / delay / maximum retries: test exact vendor interpretation.
    procd_set_param respawn 3600 10 3
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_set_param file /etc/domain-ops-directory/directory.yaml \
        /etc/domain-ops-directory/runtime.yaml
    procd_close_instance
}
# Installer validates all inputs before signaling SIGHUP or restarting ONLY this
# service. A qualified reload method is vendor-version specific; do not implement
# a generic router restart or unbounded respawn as a fallback.
