{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployment-tools.invalid/contracts/dns-changes.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/dns-change/v1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
    },
    "zone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "create",
              "update",
              "delete"
            ]
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "A",
                      "AAAA",
                      "CNAME",
                      "MX",
                      "TXT",
                      "CAA",
                      "SRV"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "ttl": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "priority": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "proxied": {
                    "type": "boolean"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "type",
                  "name",
                  "content",
                  "ttl",
                  "priority",
                  "proxied",
                  "purpose"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "A",
                      "AAAA",
                      "CNAME",
                      "MX",
                      "TXT",
                      "CAA",
                      "SRV"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "ttl": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "priority": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "proxied": {
                    "type": "boolean"
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "type",
                  "name",
                  "content",
                  "ttl",
                  "priority",
                  "proxied",
                  "purpose"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "operation",
          "record_id",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "custodian": {
      "type": "object",
      "properties": {
        "tool": {
          "enum": [
            "host-ops",
            "app-ops"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "epoch": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "tool",
        "id",
        "epoch"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "id",
    "scope",
    "zone_id",
    "policy_digest",
    "changes",
    "custodian"
  ],
  "additionalProperties": false
}
