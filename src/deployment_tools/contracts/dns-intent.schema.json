{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployment-tools.invalid/contracts/dns-intent.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "deployment-ops/dns/v1"
    },
    "provider": {
      "const": "cloudflare"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$"
    },
    "zone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "records": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 256,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "A",
              "AAAA",
              "CNAME",
              "MX",
              "TXT",
              "CAA",
              "SRV"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "ttl": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "proxied": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "type",
          "name",
          "content",
          "ttl",
          "priority",
          "proxied",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "cleanup_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "format",
    "provider",
    "scope",
    "zone_id",
    "records",
    "cleanup_record_ids"
  ],
  "additionalProperties": false
}
